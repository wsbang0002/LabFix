# LabFix Environment Variables Template
# Copy this file to .env.local for local testing with Vercel CLI

# Google Gemini API Key
GEMINI_API_KEY=your_actual_gemini_api_key_here

# Target Gemini Model (Defaults to gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Distributed Rate Limiter Configuration (Upstash Redis)
UPSTASH_REDIS_REST_URL=https://your-upstash-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_token_here

# Server-Side Test Control
# Set ALLOW_MOCK_TEST=true ONLY in development or staging environments.
# In NODE_ENV=production, mock tests are ALWAYS rejected regardless of this setting.
ALLOW_MOCK_TEST=false
LABFIX_TEST_TOKEN=your_secret_server_test_token_here